{
  "name": "repo-radar",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "radar": "tsx apps/worker/src/cli.ts",
    "db:migrate": "tsx apps/worker/src/cli.ts migrate",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "dev:web": "pnpm --filter @repo-radar/web dev",
    "build": "pnpm --filter @repo-radar/web build",
    "start": "pnpm --filter @repo-radar/web start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "node scripts/cleanup-e2e.mjs && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p e2e --noEmit && pnpm --filter @repo-radar/web run typecheck",
    "worker": "pnpm --filter @repo-radar/worker exec tsx src/worker.ts",
    "eval:llm": "tsx packages/core/eval/run.ts",
    "eval:ai": "tsx packages/core/eval/ai.ts",
    "smoke:prod": "node scripts/smoke-prod.mjs"
  },
  "dependencies": {
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}

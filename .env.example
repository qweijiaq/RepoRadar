# Auth.js 会话和数据库加密密钥（必填，生产环境缺失会拒绝启动）。
# 生成：openssl rand -base64 32
AUTH_SECRET=

# 管理员 GitHub 登录名，逗号分隔。未设置时最早注册的用户作为管理员。
# 公开部署建议显式设置，例如 ADMIN_LOGINS=alice,bob
ADMIN_LOGINS=

# 可选注册白名单，逗号分隔；设置后只有这些 GitHub 登录名能登录（管理员自动包含）。
ALLOWED_LOGINS=

# 可选：Prometheus 抓取令牌。设置后 /api/metrics 需要 Authorization: Bearer <token>。
METRICS_TOKEN=

# 可选：告警收件邮箱，逗号分隔；也可以在 /ops 页面配置。留空时发给管理员的通知邮箱。
ALERT_EMAILS=

# 首次配置页 /setup 的初始化令牌。非 localhost 访问时必须设置，否则配置页锁定。
SETUP_TOKEN=

# GitHub（强烈建议配置）。公开仓库只需要只读权限的 token。
# 如果不配置也能运行：Search 降为 10 次/分钟，且富化时跳过 README。
# 需要在 Web 的 /repos 管理自己的仓库时，token 需有 repo + delete_repo。
# https://github.com/settings/tokens
GITHUB_TOKEN=

# 数据库（与 docker-compose.yml 对应，端口 5433）
DATABASE_URL=postgres://radar:radar@localhost:5433/radar

# LLM（可选）。推荐直接在 Web 的 /settings →「AI 模型」里配置，Key 会加密存进数据库。
# 下面的环境变量只用于管理员覆盖页面配置（环境变量优先）或 CI 场景。
# 任何 OpenAI 兼容接口都可以：OpenAI、DeepSeek、Moonshot、本地 vLLM 等。
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_PROTOCOL=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# 采集默认值（可选）
RADAR_TOPICS=ai-agents,llm,developer-tools,mcp,cli
RADAR_DAYS=30
RADAR_DELAY_MS=2200

# 邮件投递（可选）。推荐直接在 Web 设置页「邮件通道」里配置，支持 QQ/163/Gmail 预设，
# 密码会用 AUTH_SECRET 加密存进数据库。下面的环境变量只用于覆盖页面配置。
# QQ 邮箱请使用授权码，不是 QQ 密码；发件人要和 SMTP 用户名一致。
SMTP_URL=
MAIL_FROM=RepoRadar <radar@localhost>

# 站点公开地址（可选）。推荐在设置页「站点地址」里配置，用于邮件链接和 Webhook 完整地址。
RADAR_BASE_URL=

# 浏览器推送（可选）。VAPID 密钥默认自动生成并加密存进数据库；
# 只有在需要固定联系邮箱时才配置。
PUSH_CONTACT=mailto:radar@localhost

# 后台任务。设置 RADAR_INLINE_JOBS=0 后，Web 只入队，由 `pnpm worker` 独立执行。
RADAR_INLINE_JOBS=

# GitHub Webhook（可选）。也可以直接在设置页保存 secret（加密存数据库）。
# 环境变量优先；在仓库 Settings → Webhooks 填完整的 https://域名/api/github/webhook。
GITHUB_WEBHOOK_SECRET=

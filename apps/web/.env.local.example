# Auth.js 与数据库加密（必填）
AUTH_SECRET=请用 openssl rand -base64 32 生成
# 管理员 GitHub 登录名，逗号分隔；未设置时最早注册用户为管理员
ADMIN_LOGINS=
# 公网首次配置令牌；非 localhost 访问必须设置
SETUP_TOKEN=
# 可选：也可以直接在 /setup 页面里填写 OAuth 凭据（环境变量优先）
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# 设为 1 时启用本地演示登录（无需 GitHub OAuth）
AUTH_DEV_MODE=0

# 数据库（与仓库根目录 docker-compose.yml 对应）
DATABASE_URL=postgres://radar:radar@localhost:5433/radar

# 可选：公测登录白名单，逗号分隔
ALLOWED_LOGINS=
